FROM node:22-alpine AS build
ARG VITE_API_URL=http://localhost:3300/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/site/package.json apps/site/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --filter @orbitask/site...
COPY apps/site apps/site
COPY packages/contracts packages/contracts
RUN pnpm --filter @orbitask/site build

FROM caddy:2.10-alpine
COPY apps/site/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/site/dist /srv
EXPOSE 8080
